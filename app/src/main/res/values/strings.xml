    <string name="intro_slide_1_label">Contexto</string>
    <string name="intro_slide_1_body">App Android individual para apoio ao enquadramento corporal e análise básica de agachamentos em vista lateral.

Esta versão foi pensada para ser simples, demonstrável e coerente com os requisitos da UC.</string>

    <string name="intro_slide_2_label">Funcionalidades</string>
    <string name="intro_slide_2_title">O que a app faz</string>
    <string name="intro_slide_2_item_1">Usa o sensor Rotation Vector para verificar se o telemóvel está alinhado.</string>
    <string name="intro_slide_2_item_2">Usa CameraX com Preview e ImageAnalysis.</string>
    <string name="intro_slide_2_item_3">Usa ML Kit Pose Detection para estimar a pose em tempo real.</string>
    <string name="intro_slide_2_item_4">Apresenta feedback textual simples sobre profundidade e conclusão do agachamento.</string>
    <string name="intro_slide_2_item_5">Permite alternar entre câmara traseira e frontal.</string>
    <string name="intro_slide_2_item_6">Permite ajustar os limiares através de botões.</string>

    <string name="intro_slide_3_label">Utilização</string>
    <string name="intro_slide_3_title">Como usar</string>
    <string name="intro_slide_3_step_1">Coloca a pessoa de perfil para a câmara.</string>
    <string name="intro_slide_3_step_2">Mantém o corpo inteiro visível no ecrã.</string>
    <string name="intro_slide_3_step_3">Verifica se o telemóvel está alinhado.</string>
    <string name="intro_slide_3_step_4">Faz o agachamento.</string>
    <string name="intro_slide_3_step_5">Ajusta os limiares se quiseres tornar a contagem mais exigente ou mais permissiva.</string>
    <string name="intro_slide_3_note">Nota: esta app é um apoio experimental e não substitui avaliação profissional.</string>

